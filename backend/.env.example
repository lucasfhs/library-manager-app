PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gomes_library_system
DB_USER=gomes_library_system_user
DB_PASSWORD=library_manager_password
DB_SSL=false
SECRET_KEY=change-this-secret
OPERATOR_REGISTRATION_KEY=Admin
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Stripe (late-fee payments). Use test-mode keys from https://dashboard.stripe.com/test/apikeys.
# Without STRIPE_SECRET_KEY the payment routes answer 503 and the rest of the API works.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (POST /payment/webhook), e.g. from `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Public URL of the frontend; Stripe Checkout returns the reader to APP_URL/loan.
APP_URL=http://localhost:5173
